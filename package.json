{
  "name": "coupon",
  "version": "1.0.0",
  "description": "This is a coupon redeem application",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node-dev ./src/server.ts",
    "start": "pm2 start ecosystem.config.js -i max",
    "restart": "pm2 restart ecosystem.config.js",
    "stop": "pm2 delete all",
    "lint": "npx eslint ./src",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsc && cp -r src/app/utils/templates dist/app/utils/",
    "format": "npx prettier --write .",
    "worker:dev": "nodemon --watch src --exec ts-node ./src/app/queue/worker.ts",
    "worker": "node ./src/app/queue/worker.ts"
  },
  "keywords": [
    "coupon",
    "products",
    "ecommerce",
    "lifestyle"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.2",
    "@types/passport-local": "^1.0.38",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.0.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.1",
    "cloudinary": "^1.41.3",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "currency-converter-lt": "^2.0.1",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.18.2",
    "firebase-admin": "^13.6.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "helmet": "^8.2.0",
    "http-status-codes": "^2.3.0",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.5",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer": "^24.43.0",
    "redis": "^6.0.0",
    "sharp": "^0.34.5",
